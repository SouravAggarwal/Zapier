# ============================================================
# Deployment Tracker API — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ============================================================

# Django core
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database -----------------------------------------------
# Leave DB_ENGINE unset to use SQLite (default for local dev).
#
# For PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=deployment_tracker
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ---- Cache TTL ----------------------------------------------
# How long (seconds) a single-deployment GET is cached in memory.
DEPLOYMENT_CACHE_TTL=300
